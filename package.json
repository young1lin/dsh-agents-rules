{
  "name": "dsh-agents-rules",
  "version": "0.2.0",
  "description": "AGENTS rules adapter for DeepSeek Harness: .agents/rules (project) and ~/.agents/rules (global) injected into the system prompt, frozen per session.",
  "type": "module",
  "author": "young1lin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/young1lin/dsh-agents-rules.git"
  },
  "homepage": "https://github.com/young1lin/dsh-agents-rules#readme",
  "bugs": "https://github.com/young1lin/dsh-agents-rules/issues",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-fs-local": "0.1.0-rc.7",
    "@deepseek-ai/dsh-sandbox": "^0.1.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "agents",
    "rules",
    "system-prompt",
    "llm",
    "coding-agent"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "packageManager": "pnpm@11.22.0"
}